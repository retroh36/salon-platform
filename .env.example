# Copy to .env.local and fill in from `npx supabase status` (local) or the
# Supabase dashboard (hosted). Never commit .env.local.

NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only. Used by the database tests (npm run test:db) to create test
# tenants. Never expose it to the browser or use it in app code.
SUPABASE_SECRET_KEY=

# Server-only. Phorest API access for the one-time import (see docs/spec.md,
# "Phorest migration"). Credentials come from Phorest. Wrap the password in
# single quotes: Next.js replaces $NAME inside unquoted or double-quoted
# values.
PHOREST_USERNAME=
PHOREST_PASSWORD=
PHOREST_BUSINESS_ID=
PHOREST_BASE_URL=

# Server-only. Denise's brain (the Claude API, from console.anthropic.com).
# Optional: without it Denise uses template wording and "Ask Denise" says
# she isn't connected. Never log it or expose it to the browser.
ANTHROPIC_API_KEY=
