# Copy to .env.local and fill in from `npx supabase status` (local) or the
# Supabase dashboard (hosted). Never commit .env.local.

# Where the app is served, for absolute links in link previews (optional:
# on Vercel the production URL is used; locally, http://localhost:3000).
NEXT_PUBLIC_SITE_URL=

NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only. Used by the public booking site's server code
# (lib/supabase/admin.ts: it has no signed-in user) and by the database
# tests (npm run test:db) to create test tenants. Never expose it to the
# browser or use it for staff pages.
SUPABASE_SECRET_KEY=

# Server-only. Phorest API access for the one-time import (see docs/spec.md,
# "Phorest migration"). Credentials come from Phorest. Wrap the password in
# single quotes: Next.js replaces $NAME inside unquoted or double-quoted
# values.
PHOREST_USERNAME=
PHOREST_PASSWORD=
PHOREST_BUSINESS_ID=
PHOREST_BASE_URL=

# Server-only. Vercel sends it to the nightly job (/api/cron/insights);
# any long random string.
CRON_SECRET=

# Server-only. Denise's brain (the Claude API, from console.anthropic.com).
# Optional: without it Denise uses template wording and "Ask Denise" says
# she isn't connected. Never log it or expose it to the browser.
ANTHROPIC_API_KEY=
