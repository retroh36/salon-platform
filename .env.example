# Copy to .env.local and fill in from `npx supabase status` (local) or the
# Supabase dashboard (hosted). Never commit .env.local.

NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only. Used by the database tests (npm run test:db) to create test
# tenants. Never expose it to the browser or use it in app code.
SUPABASE_SECRET_KEY=
