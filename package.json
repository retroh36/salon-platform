{
  "name": "maestra",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run --project unit",
    "test:db": "vitest run --project db",
    "db:reset": "supabase db reset",
    "seed:demo": "supabase db reset && docker exec -i supabase_db_salon-platform psql -q -v ON_ERROR_STOP=1 -U postgres -d postgres < supabase/seed-demo.sql && docker exec -i supabase_db_salon-platform psql -q -v ON_ERROR_STOP=1 -U postgres -d postgres < supabase/seed-large.sql && npm run insights",
    "insights": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/insights.ts",
    "db:types": "supabase gen types typescript --local > lib/database.types.ts",
    "test:e2e": "playwright test",
    "test:week": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/test-week.ts",
    "eval:denise": "vitest run --project eval",
    "import:phorest:dry-run": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/phorest-dry-run.ts",
    "backup:drill": "./scripts/backup-drill.sh",
    "photos": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/photos.ts",
    "jobs": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/jobs.ts",
    "demo:db": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/demo-db.ts",
    "test:demo": "playwright test --config playwright.demo.config.ts",
    "screenshots": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/screenshots.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.1.0",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.118.0",
    "next": "16.4.2",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "supabase": "^2.121.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.12"
  }
}
